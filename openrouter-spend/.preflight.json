      "mocks": {
        "https://openrouter.ai/api/v1/models/count": {"json": {"data": {"count": 473}}},
        "https://openrouter.ai/api/v1/key": {"json_file": "tests/fixtures/key.json"}
      },
      "expect_text": "$51.00"
    },
    "missing-key": {
      "mocks": {
        "https://openrouter.ai/api/v1/models/count": {"json": {"data": {"count": 473}}}
      },
      "expect_text": "Spend unavailable"
    }
