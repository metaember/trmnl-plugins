{% assign screen = trmnl.plugin_settings.custom_fields_values.terminal_screen | default: 'boarding_pass' %}
{% if screen == 'rotation' %}{% assign screen = IDX_0.rotation | default: rotation | default: 'boarding_pass' %}{% endif %}
{% assign screen = IDX_0.active_screen | default: active_screen | default: IDX_0.preview_screen | default: preview_screen | default: screen %}
{% assign dock = IDX_0.docking_clearance | default: docking_clearance %}
{% assign signal = IDX_0.signal_intercept | default: signal_intercept %}
{% assign survey = IDX_0.surface_survey | default: surface_survey %}
{% assign survey_depth = trmnl.device.bit_depth | plus: 0 %}
{% assign board = IDX_0.departure_board | default: departure_board %}
{% assign status = IDX_0.system_status | default: system_status %}
{% assign brief = IDX_0.mission_brief | default: mission_brief %}
{% assign ticket = IDX_0.ticket | default: ticket %}
{% assign carrier = ticket.carrier %}
{% assign document_type = ticket.document_type %}
{% assign passenger = ticket.passenger %}
{% assign origin = ticket.origin %}
{% assign destination = ticket.destination %}
{% assign flight = ticket.flight %}
{% assign gate = ticket.gate %}
{% assign seat = ticket.seat %}
{% assign departure = ticket.departure %}
{% assign boarding = ticket.boarding %}
{% assign cabin_class = ticket.cabin_class %}
{% assign barcode = ticket.barcode %}
<style>
  @font-face {
    font-family: "Departure Mono";
    font-style: normal;
    font-weight: 400;
    font-display: block;
    src: url("https://raw.githubusercontent.com/rektdeckard/departure-mono/75152a3/public/assets/DepartureMono-1.500.woff2") format("woff2");
  }

  /* The full-screen artwork uses an 800-unit canvas that scales as one piece. */
  .departure-pass, .terminal-screen { container-type: inline-size; }

  .departure-pass,
  .departure-pass * {
    box-sizing: border-box;
    font-family: "Departure Mono", monospace;
  }

  .departure-pass {
    position: relative;
    width: 800px;
    height: 480px;
    background: #fff;
    color: #000;
  }

  .departure-ticket {
    position: absolute;
    inset: 0;
  }

  .departure-main {
    position: absolute;
    top: 23px;
    left: 23px;
    width: 602px;
    height: 433px;
    border: 3px solid #000;
  }

  .departure-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 70px;
    padding: 17px 20px 0 19px;
    background: #000;
    color: #fff;
  }

  .departure-brand {
    display: flex;
    gap: 29px;
    font-size: 3cqw;
    line-height: 1;
    white-space: nowrap;
  }

  .departure-brand-heavy { font-weight: bold; }
  .departure-brand-light { font-weight: normal; }

  .departure-header .departure-micro {
    margin-top: 5px;
    font-size: 1.75cqw;
  }

  .departure-header-meta {
    position: absolute;
    top: 45px;
    right: 22px;
    font-size: 1.375cqw;
    line-height: 14px;
  }

  .departure-main-body {
    position: absolute;
    top: 70px;
    right: 0;
    bottom: 0;
    left: 0;
  }

  .departure-content {
    position: absolute;
    inset: 0;
    padding: 20px 18px;
  }

  .departure-label,
  .departure-micro {
    font-size: 1.375cqw;
    font-weight: normal;
    line-height: 11px;
    text-transform: uppercase;
  }

  .departure-passenger {
    margin-top: 7px;
    font-size: 2.75cqw;
    font-weight: bold;
    line-height: 1;
  }

  .departure-route {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 65px minmax(0, 1fr);
    gap: 11px;
    align-items: end;
    margin-top: 22px;
  }

  .departure-place {
    margin-top: 8px;
    font-size: 3.25cqw;
    font-weight: bold;
    line-height: 1;
    white-space: nowrap;
  }

  .departure-route-mark {
    display: flex;
    align-items: center;
    width: 60px;
    padding: 0 0 4px;
  }

  .departure-route-line {
    flex: 1;
    height: 3px;
    background: #000;
  }

  .departure-route-arrow {
    display: block;
    width: 10px;
    height: 10px;
    border-top: 3px solid #000;
    border-right: 3px solid #000;
    font-size: 0;
    transform: rotate(45deg);
  }

  .departure-fields {
    display: grid;
    grid-template-columns: 105px 105px 105px;
    margin-top: 24px;
  }

  .departure-times {
    display: grid;
    grid-template-columns: 105px 105px;
    margin-top: 18px;
  }

  .departure-value {
    margin-top: 4px;
    font-size: 2.5cqw;
    font-weight: bold;
    line-height: 1;
    white-space: nowrap;
  }

  .departure-times .departure-value {
    margin-top: 7px;
    font-size: 3cqw;
  }

  .departure-barcode-block {
    position: absolute;
    bottom: 1px;
    left: 19px;
    width: 560px;
    height: 62px;
    overflow: hidden;
    text-align: center;
    background: #fff;
  }

  .departure-barcode-svg {
    display: block;
    width: 560px;
    height: 40px;
    fill: #000;
  }

  .departure-barcode-text {
    margin-top: 8px;
    font-size: 1.375cqw;
    line-height: 12px;
    letter-spacing: 1px;
  }

  .departure-stub {
    position: absolute;
    top: 23px;
    left: 623px;
    width: 153px;
    height: 433px;
    border: 3px solid #000;
    background: #fff;
  }

  .departure-stub-body {
    position: absolute;
    inset: 0;
  }

  .departure-stub-column {
    position: absolute;
    top: 50%;
    font-size: 1.75cqw;
    line-height: 1;
    letter-spacing: .5px;
    white-space: nowrap;
    writing-mode: vertical-rl;
    transform: translateY(-50%) rotate(180deg);
  }

  .departure-stub-column--label {
    left: 39px;
    font-size: 2cqw;
  }

  .departure-stub-column--flight { left: 65px; }
  .departure-stub-column--gate {
    left: 90px;
    font-size: 2.5cqw;
  }
  .departure-stub-column--seat { left: 112px; }

  .departure-stub-code {
    position: absolute;
    bottom: 28px;
    left: 30px;
    width: 90px;
    overflow: hidden;
  }

  .departure-stub-code .departure-barcode-svg {
    width: 90px;
    height: 25px;
  }

  .terminal-screen, .terminal-screen * { box-sizing: border-box; font-family: "Departure Mono", monospace; }
  .terminal-screen { position: relative; width: 800px; height: 480px; color: #000; background: #fff; }
  .terminal-screen h1, .terminal-screen p, .terminal-screen pre { margin: 0; }
  .terminal-board-frame { position: absolute; inset: 14px; border: 2px solid; padding: 20px 14px 0; }
  .terminal-board-header { height: 73px; display: flex; justify-content: space-between; }
  .terminal-board-header h1 { display: inline-block; font-size: 5.25cqw; line-height: 1; border-bottom: 3px solid; }
  .terminal-board-header p { margin-top: 5px; font-size: 1.75cqw; }
  .terminal-clock { width: 180px; padding-top: 8px; font-size: 2.75cqw; line-height: 22px; text-align: right; white-space: nowrap; }
  .terminal-clock small { font-size: 1.375cqw; }
  .terminal-board-row { display: grid; grid-template-columns: 90px 80px 300px 120px 55px 1fr; align-items: center; height: 55px; font-size: 2cqw; line-height: 21px; }
  .terminal-board-row > :last-child { text-align: right; font-size: 1.75cqw; }
  .terminal-board-columns { height: 20px; border-bottom: 1px solid; font-size: 1.375cqw; line-height: 13px; }
  .terminal-board-columns > :last-child { font-size: 1.375cqw; }
  .terminal-board-code, .terminal-board-time { font-size: 2.75cqw; }
  .terminal-board-footer { display: flex; justify-content: space-between; border-top: 1px dashed; padding-top: 8px; font-size: 1.375cqw; }
  .terminal-board-indicators { display: flex; gap: 12px; }
  .terminal-board-indicators i { display: inline-block; width: 10px; height: 10px; border: 1px solid; background: #000; box-shadow: inset 0 0 0 1px #fff; }
  .terminal-board-stamp { position: absolute; bottom: 3px; left: 14px; right: 14px; display: flex; justify-content: space-between; font-size: 1.375cqw; line-height: 14px; }

  .terminal-status { padding: 20px; }
  .terminal-status-id { position: absolute; top: 3px; left: 5px; right: 5px; display: flex; justify-content: space-between; font-size: 1.375cqw; line-height: 14px; }
  .terminal-status-header { display: flex; justify-content: space-between; align-items: start; height: 51px; border-bottom: 2px solid; }
  .terminal-status-header h1 { font-size: 4cqw; font-weight: normal; }
  .terminal-status-state { width: 202px; padding: 4px 6px; border: 2px solid #000; font-size: 3cqw; }
  .terminal-status-state--alert { background: #000; color: #fff; }
  .terminal-status-grid { margin-top: 18px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px 19px; }
  .terminal-module { height: 91px; border: 1px solid; }
  .terminal-module-name { background: #000; color: #fff; padding: 3px 6px; font-size: 1.375cqw; line-height: 14px; }
  .terminal-module-data { padding: 7px 8px; font-size: 1.375cqw; line-height: 14px; }
  .terminal-module-data p { margin-bottom: 3px; }
  .terminal-meter-row { display: flex; align-items: center; gap: 5px; }
  .terminal-meter-row > span:last-child { min-width: 35px; text-align: right; }
  .terminal-segments { flex: 1; display: grid; grid-template-columns: repeat(20, minmax(0, 1fr)); border: 1px solid; gap: 1px; padding: 1px; height: 20px; }
  .terminal-segments .on { background: #000; }
  .terminal-graphs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 3px; font-size: 1.375cqw; line-height: 14px; }
  .terminal-graph-heading { display: flex; justify-content: space-between; }
  .terminal-graph { position: relative; border: 1px solid; height: 61px; }
  .terminal-graph svg { width: 100%; height: 100%; display: block; }
  .terminal-alert-title { display: flex; align-items: center; justify-content: center; height: 25px; margin: 20px -20px 10px; background: repeating-linear-gradient(90deg,#000 0 10px,#fff 10px 20px); font-size: 1.5cqw; }
  .terminal-alert-title span { background: #fff; padding: 0 12px; height: 100%; display: grid; place-items: center; }
  .terminal-alert { display: flex; justify-content: space-between; padding: 0 4px; font-size: 1.375cqw; line-height: 15px; }

  .terminal-brief { background: #000; color: #fff; padding: 18px 20px 20px; }
  .terminal-brief-header { height: 67px; border-bottom: 1px solid; font-size: 1.75cqw; line-height: 20px; }
  .terminal-brief-cursor { display: inline-block; width: 9px; height: 13px; background: #fff; vertical-align: -1px; }
  .terminal-brief-main { height: 210px; display: grid; grid-template-columns: 1fr 300px; align-items: center; }
  .terminal-brief-details { display: grid; gap: 6px; font-size: 1.75cqw; }
  .terminal-brief-details span { display: inline-block; width: 103px; font-size: 1.375cqw; }
  .terminal-ship { margin: 0; padding: 0 8px; color: #fff; }
  .terminal-ship svg { display: block; width: 284px; height: 142px; }
  .terminal-ship-guides { fill: none; stroke: white; stroke-width: 1.3; }
  .terminal-ship figcaption { border-top: 1px solid #fff; padding-top: 4px; font-size: 1.375cqw; line-height: 16px; }
  .terminal-ship figcaption > :first-child { display: flex; align-items: center; justify-content: space-between; }
  .terminal-ship figcaption strong { font-size: 2.75cqw; line-height: 22px; font-weight: normal; }
  .terminal-brief-panels { display: grid; grid-template-columns: 320px 1fr; gap: 19px; height: 165px; }
  .terminal-brief-panel { position: relative; border: 1px solid; padding: 6px 9px; font-size: 1.375cqw; }
  .terminal-brief-panel h2 { margin: 0 0 9px; border-bottom: 1px solid; font-size: 1.375cqw; font-weight: normal; }
  .terminal-brief-panel p { line-height: 17px; }
  .terminal-transfer { display: grid; grid-template-columns: 120px 174px; align-items: center; gap: 4px; margin-top: -7px; }
  .terminal-transfer-data p:nth-child(4) { margin-top: 8px; }
  .terminal-transfer-data b { display: inline-block; background: #fff; color: #000; width: 14px; padding-left: 3px; line-height: 14px; font-weight: normal; }
  .terminal-orbit { display: block; width: 174px; height: 128px; }
  .terminal-vessel-row { display: grid; grid-template-columns: 43px 1fr 39px; align-items: center; margin-bottom: 8px; }
  .terminal-vessel-row > :last-child { text-align: right; }
  .terminal-vessel-row progress { width: 100%; height: 11px; border: 1px solid #fff; background: #000; appearance: none; }
  .terminal-vessel-row progress::-moz-progress-bar { background: #fff; }
  .terminal-vessel-row progress::-webkit-progress-bar { background: #000; }
  .terminal-vessel-row progress::-webkit-progress-value { background: #fff; }
  .terminal-launch { border-top: 1px solid; padding-top: 4px; }
  .terminal-fraction, .terminal-fraction * { box-sizing: border-box; font-family: "Departure Mono", monospace; }
  .terminal-fraction.layout {
    position: relative;
    padding: 0;
    align-items: stretch;
    align-content: stretch;
    justify-items: stretch;
    justify-content: stretch;
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    overflow: hidden;
    border: 2px solid #000;
    background: #fff;
    color: #000;
    container: terminal-fraction / size;
    font-weight: normal;
  }
  .terminal-fraction h1, .terminal-fraction h2, .terminal-fraction p, .terminal-fraction figure { margin: 0; }
  .terminal-fraction h1, .terminal-fraction h2, .terminal-fraction strong, .terminal-fraction th { font-weight: normal; }
  .terminal-fraction > * {
    --inset: clamp(7px, 2.5cqw, 24px);
    --space: clamp(4px, 2cqh, 14px);
    --label: clamp(10px, min(3.3cqw, 5.4cqh), 22px);
    --reading: clamp(15px, min(5.3cqw, 8cqh), 38px);
    font-size: var(--label);
    line-height: 1.2;
    min-width: 0;
  }
  .terminal-fraction-header, .terminal-fraction-footer {
    display: flex; justify-content: space-between; align-items: baseline; gap: 8px;
    padding: var(--space) var(--inset);
  }
  .terminal-fraction-header { background: #000; color: #fff; }
  .terminal-fraction-header h1 { color: inherit; font-size: 1.15em; line-height: 1; }
  .terminal-fraction-header span, .terminal-fraction-footer span { white-space: nowrap; }
  .terminal-fraction-footer { border-top: 1px dashed currentColor; }
  .terminal-fraction-body {
    display: grid; min-height: 0; min-width: 0; gap: var(--space);
    padding: var(--space) var(--inset);
  }
  .terminal-fraction-title { font-size: var(--reading); line-height: 1.05; }
  .terminal-fraction-reading strong { display: block; font-size: var(--reading); white-space: nowrap; }
  .terminal-fraction-ticket .terminal-fraction-body { grid-template-rows: minmax(0, 1fr) auto; }
  .terminal-fraction-ticket-route { display: grid; align-content: center; gap: var(--space); }
  .terminal-fraction-route {
    display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center;
    gap: var(--space); text-align: center;
  }
  .terminal-fraction-route strong {
    display: block; font-size: clamp(24px, min(10cqw, 21cqh), 88px); line-height: 1;
  }
  .terminal-fraction-route span { display: block; }
  .terminal-fraction-route small { display: none; }
  .terminal-fraction-passenger { border-top: 1px dashed; padding-top: var(--space); }
  .terminal-fraction-ticket-fields {
    display: grid; grid-template-columns: 1.35fr 1fr 0.85fr; gap: var(--space);
    align-items: center; border-top: 1px solid; padding-top: var(--space);
  }
  .terminal-fraction-ticket-fields > div:not(:first-child) { border-left: 1px solid; padding-left: var(--space); }
  .terminal-fraction-barcode { display: none; width: 100%; height: 100%; min-height: 0; }
  .terminal-fraction-board {
    display: grid; grid-template-rows: auto; grid-auto-rows: minmax(0, 1fr);
    min-height: 0; min-width: 0;
  }
  .terminal-fraction-board-row {
    display: grid; grid-template-columns: 4.6em minmax(0, 1fr) 3em 7em;
    align-items: center; column-gap: 0.4em; border-top: 1px solid;
  }
  .terminal-fraction-board-row > :last-child { text-align: right; }
  .terminal-fraction-board-head { border-top: 0; padding-bottom: 0.3em; }
  .board-heading-narrow { display: none; }
  .terminal-fraction-board-time { font-size: 1.28em; }
  .terminal-fraction-board .board-place { white-space: normal; }
  .terminal-fraction-board .board-place strong { font-size: 1.22em; }
  .terminal-fraction-board .board-place span { display: block; line-height: 1.1; }
  .terminal-fraction-board .board-changed { text-decoration: underline; text-underline-offset: 0.2em; }
  .terminal-fraction-board .terminal-fraction-extended { display: none; }
  .terminal-fraction-status .terminal-fraction-body { grid-template-rows: minmax(0, 1fr); }
  .terminal-fraction-meters { display: grid; gap: var(--space); min-height: 0; }
  .terminal-fraction-meter {
    display: grid; align-content: center; gap: 3px;
    border: 1px solid; padding: clamp(3px, 1.2cqh, 10px) var(--space);
  }
  .terminal-fraction-meter p, .terminal-fraction-graph figcaption { display: flex; justify-content: space-between; gap: 3px; }
  .terminal-fraction-meter p > span { min-width: 0; overflow-wrap: anywhere; }
  .terminal-fraction-meter strong { font-size: 1.25em; }
  .terminal-fraction-meter .terminal-segments { height: clamp(7px, 4cqh, 22px); }
  .terminal-fraction-meter-alert { border-width: 2px; }
  .terminal-fraction-meter-alert .terminal-segments .on {
    background: repeating-linear-gradient(135deg, #000 0 2px, #fff 2px 3px);
  }
  .terminal-fraction-graph { display: none; min-height: 0; min-width: 0; }
  .terminal-fraction-graph svg { width: 100%; height: 100%; min-height: 0; border: 1px solid; }
  .terminal-fraction-meters .terminal-fraction-extended { display: none; }
  .terminal-fraction.layout:is(.terminal-fraction-brief, .terminal-fraction-signal) { background: #000; color: #fff; }
  :is(.terminal-fraction-brief, .terminal-fraction-signal) .terminal-fraction-header { border-bottom: 1px solid; }
  .terminal-fraction-brief .terminal-fraction-body { grid-template: minmax(0, 1fr) auto / 1fr 1fr; }
  .terminal-fraction-brief-summary, .terminal-fraction-dock-summary { display: grid; align-content: center; gap: var(--space); min-width: 0; }
  .terminal-fraction-brief .terminal-fraction-title { overflow-wrap: break-word; }
  .terminal-fraction-ship {
    display: grid; grid-template-rows: minmax(0, 1fr) auto;
    min-height: 0; min-width: 0;
  }
  .terminal-fraction-ship svg { display: block; width: 100%; height: 100%; }
  .terminal-fraction-ship figcaption { border-top: 1px solid; padding-top: 3px; }
  .terminal-fraction-gauges {
    grid-column: 1 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px calc(var(--space) * 2); border-top: 1px solid; padding-top: var(--space);
  }
  .terminal-fraction-gauges .terminal-vessel-row {
    grid-template-columns: 5ch minmax(0, 1fr) 4ch; gap: 4px; margin: 0;
  }
  .terminal-fraction-dock .terminal-fraction-body { grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); }
  .terminal-fraction-dock .st-dock-map { width: 100%; height: 100%; min-height: 0; }
  .terminal-fraction-berth { font-size: clamp(24px, min(11cqw, 25cqh), 92px); line-height: 1; }
  .terminal-fraction-clearance { border-top: 1px solid; padding-top: var(--space); }
  .terminal-fraction-clearance.hold { background: #000; color: #fff; padding: 0.35em 0.45em; }
  .terminal-fraction-signal .terminal-fraction-body { grid-template-columns: minmax(0, 1fr) minmax(0, 0.36fr); align-items: center; }
  .terminal-fraction-scope {
    width: 100%; height: 100%; min-height: 0; max-height: 59cqw;
    display: block; border: 1px solid; color: #fff;
  }
  .terminal-fraction-scope-split { display: none; }
  .terminal-fraction-scope .st-signal-trace { stroke-width: 1.8; }
  .terminal-fraction-signal .terminal-fraction-reading { display: grid; gap: var(--space); overflow-wrap: anywhere; }
  .terminal-fraction-signal .terminal-fraction-reading strong { font-size: clamp(12px, min(3.3cqw, 8cqh), 35px); }
  .terminal-fraction-distress { background: #fff; color: #000; padding: 2px 5px; }
  .terminal-fraction-survey .terminal-fraction-body { padding: 0; gap: 0; grid-template-columns: minmax(0, 1fr) minmax(72px, 24%); }
  .terminal-fraction-survey-map { min-height: 0; min-width: 0; overflow: hidden; }
  .terminal-fraction-survey-map img { display: block; width: 100%; height: 100%; }
  .terminal-fraction-survey-map .survey-tall { display: none; }
  .terminal-fraction-survey .terminal-fraction-reading {
    display: grid; align-content: start; gap: var(--space); padding: var(--space); border-left: 1px solid;
  }
  .terminal-fraction-survey .terminal-fraction-reading strong { font-size: clamp(14px, min(5cqw, 7cqh), 32px); }
  @container terminal-fraction (min-width: 480px) and (min-aspect-ratio: 2/1) {
    .terminal-fraction-ticket .terminal-fraction-body { grid-template: minmax(0, 1fr) / minmax(0, 1fr) minmax(0, 0.75fr); }
    .terminal-fraction-ticket-fields { border-top: 0; border-left: 1px dashed; padding: 0 0 0 var(--space); }
    .terminal-fraction-status .terminal-fraction-body { grid-template-columns: minmax(0, 1fr) minmax(0, 0.55fr); }
    .terminal-fraction-meters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .terminal-fraction-graph { display: grid; grid-template-rows: auto minmax(0, 1fr); gap: var(--space); }
    .terminal-fraction-meters .terminal-fraction-extended { display: grid; }
    .terminal-fraction-board .terminal-fraction-extended { display: grid; }
    .terminal-fraction-board .board-place span { display: inline; margin-left: 0.5em; }
    .terminal-fraction-brief .terminal-fraction-body { grid-template: minmax(0, 1fr) / minmax(0, 1.05fr) minmax(0, 1fr) minmax(0, 0.75fr); }
    .terminal-fraction-gauges { grid-column: auto; grid-template-columns: 1fr; align-content: center; border-top: 0; border-left: 1px solid; padding: 0 0 0 var(--space); }
  }
  @container terminal-fraction (min-height: 300px) and (min-aspect-ratio: 11/10) and (max-aspect-ratio: 2/1) {
    .terminal-fraction-ticket .terminal-fraction-body { grid-template-rows: minmax(0, 1fr) auto minmax(12px, 12%); }
    .terminal-fraction-barcode { display: block; }
    .terminal-fraction-board .terminal-fraction-extended { display: grid; }
    .terminal-fraction-status .terminal-fraction-body { grid-template-rows: minmax(0, 1fr) minmax(0, 0.48fr); }
    .terminal-fraction-meters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .terminal-fraction-meters .terminal-fraction-extended { display: grid; }
    .terminal-fraction-graph { display: grid; grid-template-rows: auto minmax(0, 1fr); gap: var(--space); }
  }
  @container terminal-fraction (max-aspect-ratio: 11/10) {
    .terminal-fraction-ticket .terminal-fraction-body { grid-template-rows: minmax(0, 1fr) auto minmax(12px, 12%); }
    .terminal-fraction-ticket-route { align-content: space-evenly; }
    .terminal-fraction-route { grid-template: auto auto / minmax(0, 1fr); }
    .terminal-fraction-route div { display: grid; grid-template-columns: 1fr 1fr; align-items: baseline; text-align: left; }
    .terminal-fraction-route div span { text-align: right; }
    .terminal-fraction-route small { display: block; grid-column: 1 / -1; }
    .terminal-fraction-route > span { display: none; }
    .terminal-fraction-barcode { display: block; }
    .terminal-fraction-board .terminal-fraction-extended { display: grid; }
    .terminal-fraction-status .terminal-fraction-body { grid-template-rows: minmax(0, 1fr) minmax(0, 0.36fr); }
    .terminal-fraction-meters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .terminal-fraction-meters .terminal-fraction-extended { display: grid; }
    .terminal-fraction-graph { display: grid; grid-template-rows: auto minmax(0, 1fr); gap: var(--space); }
    .terminal-fraction-brief .terminal-fraction-body { grid-template: auto minmax(0, 1fr) auto / minmax(0, 1fr); }
    .terminal-fraction-dock .terminal-fraction-body { grid-template: auto minmax(0, 1fr) / minmax(0, 1fr); }
    .terminal-fraction-signal .terminal-fraction-body { grid-template: minmax(0, 1fr) auto / minmax(0, 1fr); align-items: center; }
    .terminal-fraction-signal .terminal-fraction-reading { grid-template-columns: 1fr 1fr; border-top: 1px solid; padding-top: var(--space); }
    .terminal-fraction-survey .terminal-fraction-body { grid-template: minmax(0, 1fr) auto / minmax(0, 1fr); }
    .terminal-fraction-survey-map .survey-wide { display: none; }
    .terminal-fraction-survey-map .survey-tall { display: block; }
    .terminal-fraction-survey .terminal-fraction-reading { display: flex; justify-content: space-between; align-items: baseline; border: 0; border-top: 1px solid; }
  }
  @container terminal-fraction (max-aspect-ratio: 7/10) {
    .terminal-fraction-signal .terminal-fraction-body { align-items: stretch; }
    .terminal-fraction-scope-main { display: none; }
    .terminal-fraction-scope-split { display: grid; grid-template-rows: repeat(2, minmax(0, 1fr)); gap: var(--space); min-height: 0; }
    .terminal-fraction-scope { max-height: none; }
  }
  @container terminal-fraction (max-width: 285px) {
    .terminal-fraction-ticket-fields strong { font-size: 1.25em; }
    .terminal-fraction-header .terminal-fraction-secondary { display: none; }
    .terminal-fraction-board .board-place span { display: none; }
    .board-heading-wide { display: none; }
    .board-heading-narrow { display: inline; }
    .terminal-fraction-meter strong { font-size: 1em; }
  }
  @container terminal-fraction (max-height: 179px) {
    .terminal-fraction-header, .terminal-fraction-footer { padding-block: 3px; }
    .terminal-fraction-route div > span { display: none; }
    .terminal-fraction-brief .terminal-fraction-gauges { padding-block: 2px; }
    .terminal-fraction-board .terminal-fraction-extended, .terminal-fraction-meters .terminal-fraction-extended { display: none; }
  }

  .terminal-portrait { display: none; }
  /* atan2/tan gives Firefox a unitless scale without typed CSS division. */
  @supports (zoom: tan(atan2(1px, 1px))) {
    .view--full { container-type: size; container-name: terminal-display; }
    @container terminal-display (width < 800px) or (width > 800px) or (height < 480px) or (height > 480px) {
      .view--full > :is(.terminal-screen, .departure-pass) {
        position: absolute;
        inset: 0;
        margin: auto;
        zoom: min(tan(atan2(100cqw, 800px)), tan(atan2(100cqh, 480px)));
      }
    }
    @container terminal-display (max-aspect-ratio: 1/1) {
      .view--full > :is(.terminal-screen, .departure-pass) { display: none; }
      .terminal-portrait { display: block; width: 100%; height: 100%; }
    }
  }

  .st-dock-frame {
    position: absolute;
    inset: 8px;
    display: grid;
    grid-template-rows: 72px minmax(0, 1fr) 65px;
    border: 3px solid #000;
  }

  .st-dock-header {
    display: flex;
    align-items: center;
    padding: 0 22px;
    background: #000;
    color: #fff;
  }

  .st-dock-header h1 {
    font-size: 6.875cqw;
    line-height: 56px;
    font-weight: normal;
  }

  .st-dock-body {
    display: grid;
    grid-template-columns: 377px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    padding: 0 22px;
  }

  .st-dock-berth {
    padding-bottom: 8px;
    border-bottom: 3px solid #000;
    font-size: 16.5cqw;
    line-height: 132px;
  }

  .st-dock .st-dock-destination {
    margin-top: 17px;
    font-size: 4.125cqw;
    line-height: 33px;
  }

  .st-dock .st-dock-destination-long {
    font-size: 2.75cqw;
    line-height: 33px;
  }

  .st-dock .st-dock-clearance {
    margin-top: 10px;
    font-size: 2.75cqw;
    line-height: 22px;
  }

  .st-dock-map {
    display: block;
    width: 100%;
    height: 300px;
  }

  .st-dock-footer {
    display: grid;
    grid-template-columns: 36% 28% 36%;
    align-items: stretch;
    border-top: 3px solid #000;
    padding: 4px 0;
  }

  .st-dock-footer p {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
  }

  .st-dock-footer p + p {
    border-left: 2px solid #000;
  }

  .st-dock-footer span {
    font-size: 1.75cqw;
  }

  .st-dock-footer strong {
    font-size: 2.75cqw;
    line-height: 22px;
    font-weight: normal;
  }

  .st-signal {
    display: grid;
    grid-template-rows: 76px minmax(0, 1fr) 54px;
    gap: 20px;
    padding: 18px 18px 16px;
    background: #000;
    color: #fff;
  }

  .st-signal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px solid;
    font-size: 2cqw;
  }

  .st-signal .st-signal-header h1 {
    font-size: 6.875cqw;
    line-height: 66px;
    letter-spacing: 2px;
    font-weight: 400;
  }

  .st-signal-body {
    display: grid;
    grid-template-columns: 500px minmax(0, 1fr);
    gap: 20px;
  }

  .st-signal-plot {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    border: 2px solid;
  }

  .st-signal-grid {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-dasharray: 1 5;
  }

  .st-signal-marker path:first-child {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-dasharray: 6 4;
  }

  .st-signal-marker path:last-child { fill: currentColor; }

  .st-signal-trace {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .st-signal-readouts {
    display: grid;
    grid-template-rows: 1fr 1fr;
  }

  .st-signal-frequency,
  .st-signal-source {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .st-signal-frequency {
    border-bottom: 2px solid;
    font-size: 5.5cqw;
    line-height: 48px;
  }

  .st-signal-source {
    font-size: 4.125cqw;
    line-height: 36px;
  }

  .st-signal-source strong {
    max-width: 100%;
    font-size: 4.125cqw;
    line-height: 35px;
    overflow-wrap: anywhere;
  }

  .st-signal-frequency strong,
  .st-signal-source strong,
  .st-signal-footer strong { font-weight: 400; }

  .st-signal-footer {
    display: flex;
    align-items: center;
    gap: 16px;
    border-top: 2px solid;
    font-size: 2.75cqw;
    line-height: 26px;
  }

  .st-survey { padding: 14px; }
  .st-survey-plate {
    width: 100%;
    height: 100%;
    border: 2px solid black;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 206px;
  }
  .st-survey-chart {
    min-width: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: 74px minmax(0, 1fr);
  }
  .st-survey-head {
    padding: 9px 20px;
    color: white;
    background: black;
  }
  .st-survey-head h1 {
    margin: 0;
    font-size: 4.125cqw;
    line-height: 35px;
    font-weight: normal;
  }
  .st-survey-head p {
    margin: 1px 0 0;
    font-size: 2.25cqw;
    line-height: 20px;
  }
  .st-survey-map {
    width: 100%;
    height: 100%;
    display: block;
    overflow: hidden;
    background: white;
  }
  .st-survey-map text {
    fill: black;
    font-size: 1.875cqw;
    font-weight: bold;
  }
  .st-survey-contours {
    fill: none;
    stroke: black;
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .st-survey-index { stroke-width: 2.2; }
  .st-survey-notes {
    display: grid;
    align-content: center;
    gap: 24px;
    padding: 16px;
    border-left: 2px solid black;
  }
  .st-survey-feature {
    font-size: 2.875cqw;
    line-height: 26px;
    overflow-wrap: normal;
  }
  .st-survey-reading {
    padding: 17px 0;
    border-block: 2px solid black;
  }
  .st-survey-reading span,
  .st-survey-state {
    font-size: 2cqw;
    line-height: 18px;
  }
  .st-survey-reading strong {
    display: block;
    margin-top: 5px;
    font-size: 4.125cqw;
    line-height: 35px;
    font-weight: normal;
  }
  .st-relief-light, .st-relief-deep { fill: none; }
  .screen--2bit .st-relief-deep { fill: #aaa; }
  .screen--4bit .st-relief-light, .screen--color-full .st-relief-light { fill: #ddd; }
  .screen--4bit .st-relief-deep, .screen--color-full .st-relief-deep { fill: #bbb; }
  .st-survey-map-ticks {
    fill: none;
    stroke: #000;
    stroke-width: 1;
  }
  .st-survey-datum {
    display: grid;
    gap: 4px;
    padding-top: 8px;
    border-top: 1px solid;
    font-size: 1.375cqw;
    line-height: 14px;
  }
  .st-survey-datum b { display: inline-block; width: 14px; font-weight: normal; }
</style>

{% template terminal_station_map %}
<svg class="st-dock-map" viewBox="0 0 350 300" role="img" aria-label="Station approach to berth {{ dock.berth | escape }}">
  <g transform="translate(175 150)" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M0 -140V-118 M0 118V140 M-140 0H-118 M118 0H140" stroke-dasharray="6 5"/>
    {% for spoke in (1..8) %}
      {% assign spoke_angle = forloop.index0 | times: 45 %}
      <path d="M-4 -25V-72 M4 -25V-72" transform="rotate({{ spoke_angle }})"/>
    {% endfor %}
    <circle r="86"/>
    <circle r="72"/>
    {% for slot in (1..12) %}
      {% assign slot_angle = forloop.index0 | times: 30 %}
      {% assign divider_angle = slot_angle | plus: 15 %}
      <path d="M0 -72V-86" transform="rotate({{ divider_angle }})"/>
      <path d="M-2 -79H2" transform="rotate({{ slot_angle }})" stroke-width="3"/>
    {% endfor %}
    {% for pod in (1..4) %}
      {% assign pod_angle = forloop.index0 | times: 90 | plus: 45 %}
      <g transform="rotate({{ pod_angle }})">
        <path d="M-5 -101L-3 -106H3L5 -101 M-5 -71V-66H5V-71"/>
        <rect x="-9" y="-101" width="18" height="30" fill="white"/>
        <path d="M0 -95V-92 M0 -87V-84 M0 -79V-76" stroke-width="3"/>
      </g>
    {% endfor %}
    <circle r="30" fill="white"/>
    <circle r="23"/>
    <path d="M-23 0H23"/>
    <rect x="-8" y="-8" width="16" height="16" fill="white"/>
    {% assign berth_angle = dock.berth_angle | plus: 0 | modulo: 360 %}
    <g transform="rotate({{ berth_angle }})">
      <path d="M-12 -85.2A86 86 0 0 1 12 -85.2L10 -71.3A72 72 0 0 0 -10 -71.3Z" fill="currentColor" stroke="none"/>
      <path d="M-87 -111C-63 -131 -19 -139 -4 -109Q0 -101 0 -95" stroke-width="3" stroke-dasharray="3 6"/>
      <path d="M-6 -98H6L0 -85Z" fill="currentColor" stroke="none"/>
    </g>
  </g>
</svg>
{% endtemplate %}

{% template terminal_system_meter %}
{% assign fill = system.value | divided_by: 5.0 | round %}
<div class="terminal-segments" aria-hidden="true">
  {% for segment in (1..20) %}<span{% if segment <= fill %} class="on"{% endif %}></span>{% endfor %}
</div>
{% endtemplate %}

{% template terminal_vessel_gauges %}
{% assign fuel = brief.details.fuel | split: '%' | first %}
{% assign labels = 'FUEL,O2,POWER,HULL' | split: ',' %}
{% assign defaults = '85,98,92,100' | split: ',' %}
{% for label in labels %}
  {% assign reading = brief.gauges[forloop.index0].value | default: defaults[forloop.index0] %}
  {% if label == 'FUEL' %}{% assign reading = fuel %}{% endif %}
  <div class="terminal-vessel-row"><span>{{ label }}</span><progress max="100" value="{{ reading }}" aria-label="{{ label }}"></progress><span>{{ reading }}%</span></div>
{% endfor %}
{% endtemplate %}

{% template terminal_survey_compact_map %}
{% capture map_svg %}
{% if tall %}
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 350 560" preserveAspectRatio="xMidYMid slice">
  <g transform="translate(350 0) rotate(90)">
{% else %}
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 560 350" preserveAspectRatio="xMidYMid slice">
  <g>
{% endif %}
  {% if depth >= 4 %}
    <path fill="#ddd" fill-rule="evenodd" d="{{ survey.shading[0] | escape }}"/>
    <path fill="#bbb" fill-rule="evenodd" d="{{ survey.shading[1] | escape }}"/>
  {% elsif depth == 2 %}
    <path fill="#aaa" fill-rule="evenodd" d="{{ survey.shading[1] | escape }}"/>
  {% endif %}
  <g fill="none" stroke="black" stroke-width="1.6" stroke-linejoin="round">
    {% for contour in survey.contours %}
      {% assign index_contour = forloop.index | modulo: 3 %}
      <path{% if index_contour == 0 %} stroke-width="2.4"{% endif %} d="{{ contour | escape }}"/>
    {% endfor %}
  </g>
  <circle cx="{{ survey.site_x | plus: 0 }}" cy="{{ survey.site_y | plus: 0 }}" r="10" fill="black" stroke="white" stroke-width="4"/>
  {% if survey.site_b %}
    <path d="M{{ survey.site_b.x | plus: 0 }} {{ survey.site_b.y | minus: 10 }}l10 10-10 10-10-10Z" fill="white" stroke="black" stroke-width="4"/>
  {% endif %}
  </g>
  </svg>
{% endcapture %}
<img class="{% if tall %}survey-tall{% else %}survey-wide{% endif %}" src="data:image/svg+xml;base64,{{ map_svg | base64_encode }}" alt="Topographic contours and survey sites">
{% endtemplate %}

{% template terminal_signal_scope %}
{% assign signal_marker = signal.marker | plus: 0 | at_least: 8 | at_most: 492 %}
{% assign trace = signal.trace %}
{% assign grid = 'M125 4V236 M250 4V236 M375 4V236 M4 60H496 M4 180H496' %}
{% if width != 500 %}
  {% assign points = trace | split: ' ' %}
  {% if start == 0 %}
    {% assign trace = points | slice: 0, 63 | join: ' ' %}
    {% assign grid = 'M124 4V236 M4 60H244 M4 180H244' %}
  {% else %}
    {% assign trace = points | slice: 62, 64 | join: ' ' %}
    {% assign grid = 'M374 4V236 M252 60H496 M252 180H496' %}
  {% endif %}
{% endif %}
{% assign marker_min = start | plus: 8 %}
{% assign marker_max = start | plus: width | minus: 8 %}
<svg class="terminal-fraction-scope{% if width == 500 %} terminal-fraction-scope-main{% endif %}" viewBox="{{ start }} 0 {{ width }} 240" preserveAspectRatio="none" role="img" aria-label="{{ description }}">
  <g class="st-signal-grid"><path d="{{ grid }}"/></g>
  {% unless signal.distress or signal.kind == 'QUIET SCAN' %}
    {% if signal_marker >= marker_min and signal_marker <= marker_max %}
      <g class="st-signal-marker" transform="translate({{ signal_marker }},0)"><path d="M0 15V225"/><path d="M-7 4H7L0 14Z M-7 236H7L0 226Z"/></g>
    {% endif %}
  {% endunless %}
  <polyline class="st-signal-trace" points="{{ trace | escape }}"/>
</svg>
{% endtemplate %}

{% template terminal_compact %}
{% case screen %}
{% when 'boarding_pass' %}
<div class="layout terminal-fraction terminal-fraction-ticket">
  <header class="terminal-fraction-header"><h1>BOARDING PASS</h1><span class="terminal-fraction-secondary">{{ ticket.carrier | escape }}</span></header>
  <div class="terminal-fraction-body">
    <div class="terminal-fraction-ticket-route">
      <div class="terminal-fraction-route">
        <div><small>FROM</small><strong>{{ ticket.origin_code }}</strong><span>{{ ticket.origin | escape }}</span></div>
        <span aria-hidden="true">TO</span>
        <div><small>TO</small><strong>{{ ticket.destination_code }}</strong><span>{{ ticket.destination | escape }}</span></div>
      </div>
      <p class="terminal-fraction-passenger">{{ ticket.passenger | escape }}</p>
    </div>
    <div class="terminal-fraction-ticket-fields">
      <div class="terminal-fraction-reading">FLIGHT<strong>{{ ticket.flight }}</strong></div>
      <div class="terminal-fraction-reading">GATE<strong>{{ ticket.gate }}</strong></div>
      <div class="terminal-fraction-reading">SEAT<strong>{{ ticket.seat }}</strong></div>
    </div>
    <svg class="terminal-fraction-barcode" viewBox="0 0 560 40" preserveAspectRatio="none" aria-hidden="true">
      {% for bar in ticket.barcode_bars %}<rect x="{{ bar.x }}" width="{{ bar.width }}" height="40"/>{% endfor %}
    </svg>
  </div>
  <footer class="terminal-fraction-footer"><span>BOARD {{ ticket.boarding }}</span><span>DEPART {{ ticket.departure }}</span></footer>
</div>
{% when 'departure_board' %}
<div class="layout terminal-fraction terminal-fraction-departures">
  <header class="terminal-fraction-header"><h1>{{ board.title | escape }}</h1><span>{{ board.telemetry.stamp | slice: 0, 10 }}</span></header>
  <div class="terminal-fraction-body">
    <div class="terminal-fraction-board" role="table" aria-label="{{ board.title | escape }}">
      <div class="terminal-fraction-board-row terminal-fraction-board-head" role="row">
        <span role="columnheader">TIME</span>
        <span role="columnheader">
          <span class="board-heading-wide">{{ board.place_heading | default: 'DESTINATION' }}</span>
          <span class="board-heading-narrow">{% case board.place_heading %}{% when 'ORIGIN' %}FROM{% when 'CONNECTION' %}VIA{% else %}TO{% endcase %}</span>
        </span>
        <span role="columnheader">GATE</span><span role="columnheader">STATUS</span>
      </div>
      {% for row in board.destinations limit: 5 %}
        <div class="terminal-fraction-board-row{% if forloop.index > 3 %} terminal-fraction-extended{% endif %}" role="row">
          <span class="terminal-fraction-board-time" role="cell">{{ row.time }}</span>
          <div class="board-place" role="cell"><strong>{{ row.code }}</strong><span>{{ row.name | escape }}</span></div>
          <span role="cell">{{ row.gate }}</span><span role="cell"{% if row.status == 'DELAYED' or row.status == 'GATE CHANGE' or row.status == 'FINAL CALL' %} class="board-changed"{% endif %}>{{ row.status | escape }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
  <footer class="terminal-fraction-footer"><span>KÁRMÁN SPACELINES</span><span>EXT {{ board.telemetry.temp }}</span></footer>
</div>
{% when 'system_status' %}
<div class="layout terminal-fraction terminal-fraction-status">
  <header class="terminal-fraction-header"><h1 class="title">SYSTEM STATUS</h1><span>[{{ status.systemStatus }}]</span></header>
  <div class="terminal-fraction-body">
    <div class="terminal-fraction-meters">
      {% assign lowest = status.systems | sort: 'value' %}
      {% for system in lowest limit: 6 %}
        <div class="terminal-fraction-meter{% if forloop.index > 3 %} terminal-fraction-extended{% endif %}{% if system.status != 'ONLINE' %} terminal-fraction-meter-alert{% endif %}">
          <p><span>{{ system.name | escape }}</span><strong>{{ system.value }}%</strong></p>
          {% render "terminal_system_meter" with system: system %}
        </div>
      {% endfor %}
    </div>
    <figure class="terminal-fraction-graph">
      <figcaption><span>CORE TEMP</span><span>{{ status.temperature_profile | escape }}</span></figcaption>
      <svg viewBox="0 0 370 60" preserveAspectRatio="none" role="img" aria-label="Core temperature trend">
        <polyline points="{{ status.temperature_trace | escape }}" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke"/>
      </svg>
    </figure>
  </div>
  <footer class="terminal-fraction-footer"><span>CORE {{ status.temperature }} K</span><span>{{ status.dose | default: '0.42' }} mSv</span></footer>
</div>
{% when 'mission_brief' %}
<div class="layout terminal-fraction terminal-fraction-brief">
  <header class="terminal-fraction-header"><h1>MISSION BRIEF</h1><span>RISK {{ brief.details.risk }}</span></header>
  <div class="terminal-fraction-body">
    <div class="terminal-fraction-brief-summary">
      <h2 class="terminal-fraction-title">{{ brief.missionCode | escape }}</h2>
      <p>{{ brief.details.objective | escape }}</p>
    </div>
    <figure class="terminal-fraction-ship">
      <svg viewBox="0 0 200 100" role="img" aria-label="{{ brief.ship.name | escape }} spacecraft">
        <g class="terminal-ship-guides"><path d="M3 9V3H9 M191 3H197V9 M197 91V97H191 M9 97H3V91 M3 50H197 M100 3V97" stroke-dasharray="2 4"/></g>
        <path fill="white" d="{{ brief.ship.hull | escape }}"/>
        <path fill="none" stroke="black" stroke-width="2" d="{{ brief.ship.etch | escape }}"/>
      </svg>
      <figcaption>{{ brief.ship.name | escape }} / {{ brief.ship.model | escape }}</figcaption>
    </figure>
    <div class="terminal-fraction-gauges">{% render "terminal_vessel_gauges" with brief: brief %}</div>
  </div>
  <footer class="terminal-fraction-footer"><span>DURATION {{ brief.details.duration }}</span><span>{{ brief.details.cargo | escape }}</span></footer>
</div>
{% when 'docking_clearance' %}
<div class="layout terminal-fraction terminal-fraction-dock">
  <header class="terminal-fraction-header"><h1>DOCKING CLEARANCE</h1><span>{{ dock.vessel | escape }}</span></header>
  <div class="terminal-fraction-body">
    <div class="terminal-fraction-dock-summary">
      <div><p>ASSIGNED BERTH</p><strong class="terminal-fraction-berth">{{ dock.berth | escape }}</strong></div>
      <h2 class="terminal-fraction-title">{{ dock.destination | escape }}</h2>
      <p class="terminal-fraction-clearance{% if dock.clearance contains 'HOLD' %} hold{% endif %}">{{ dock.clearance | escape }}</p>
    </div>
    {% render "terminal_station_map" with dock: dock %}
  </div>
  <footer class="terminal-fraction-footer"><span>{{ dock.side | escape }}</span><span>APPROACH {{ dock.bearing | escape }}</span></footer>
</div>
{% when 'signal_intercept' %}
<div class="layout terminal-fraction terminal-fraction-signal">
  <header class="terminal-fraction-header"><h1>SIGNAL INTERCEPT</h1><span{% if signal.distress %} class="terminal-fraction-distress"{% endif %}>{{ signal.kind | default: 'ACQUIRED' | escape }}</span></header>
  <div class="terminal-fraction-body">
    {% render "terminal_signal_scope" with signal: signal, start: 0, width: 500, description: 'Signal waveform' %}
    <div class="terminal-fraction-scope-split">
      {% render "terminal_signal_scope" with signal: signal, start: 0, width: 248, description: 'First half of signal waveform' %}
      {% render "terminal_signal_scope" with signal: signal, start: 248, width: 252, description: 'Second half of signal waveform' %}
    </div>
    <div class="terminal-fraction-reading"><p><strong>{{ signal.frequency | escape }}</strong>MHz</p><p>{{ signal.source | escape }}</p></div>
  </div>
  <footer class="terminal-fraction-footer"><span>{% if signal.distress %}SOS / ... --- ...{% else %}RECEIVER MONITOR{% endif %}</span><span>REPEAT {{ signal.repeat_interval | escape }}</span></footer>
</div>
{% when 'surface_survey' %}
<div class="layout terminal-fraction terminal-fraction-survey">
  <header class="terminal-fraction-header"><h1>SURFACE SURVEY</h1><span>{{ survey.world | escape }} / {{ survey.sector | escape }}</span></header>
  <div class="terminal-fraction-body">
    <div class="terminal-fraction-survey-map">
      {% render "terminal_survey_compact_map" with survey: survey, tall: false, depth: survey_depth %}
      {% render "terminal_survey_compact_map" with survey: survey, tall: true, depth: survey_depth %}
    </div>
    <div class="terminal-fraction-reading">
      <p>{{ survey.feature | escape }}</p>
      <p><strong>{{ survey.relief | plus: 0 }} M</strong>RELIEF</p>
      <p>● A{% if survey.site_b %} / ◇ B{% endif %}</p>
    </div>
  </div>
  <footer class="terminal-fraction-footer"><span>{{ survey.status | escape }}</span><span>{{ survey.interval }} M CONTOURS</span></footer>
</div>
{% endcase %}
{% endtemplate %}
