{% template brief_source %}
  {% if source.url %}
    <a class="label {{ source_size }} label--underline {{ source_alignment }}" href="{{ source.url | escape }}" data-clamp="1">{{ source.domain | escape }}</a>
  {% endif %}
{% endtemplate %}

{% template brief_image %}
  {% assign image_frame = "image--contain w--full h--[72cqh]" %}
  {% assign caption_lines = 2 %}
  {% if size == "banner" %}
    {% assign image_frame = "image--cover w--[50cqw] h--[57cqh]" %}
    {% assign caption_lines = 1 %}
  {% elsif size == "quadrant" %}
    {% assign image_frame = "image--cover w--[72cqw] h--[57cqh]" %}
    {% assign caption_lines = 1 %}
  {% elsif size == "column" %}
    {% assign image_frame = "image--contain w--full h--[65cqh]" %}
  {% endif %}
  <figure class="flex flex--col flex--center-x gap--small w--full">
    <img class="image image-dither {{ image_frame }}" src="{{ brief.image_url | escape }}" alt="">
    <figcaption class="flex flex--col flex--stretch-x gap--xsmall w--full">
      <span class="title {{ title_size }} text--center w--full" data-clamp="1">{{ brief.headline | escape }}</span>
      {% if brief.answer != blank %}
        <p class="description description--large text--center w--full" data-clamp="{{ caption_lines }}">{{ brief.answer | escape }}</p>
      {% endif %}
      {% render "brief_source" with source: brief.source, source_size: source_size, source_alignment: "self--center" %}
    </figcaption>
  </figure>
{% endtemplate %}

{% template brief_heading %}
  <span class="title {{ title_size }} text--left" data-clamp="{{ title_lines }}">{{ headline | escape }}</span>
  <div class="divider"></div>
{% endtemplate %}

{% template brief_chart %}
  {% assign chart_id = "prompt-frame-chart" | append_random %}
  {% assign chart_height = "h--[65cqh]" %}
  {% assign chart_points = brief.points %}
  {% if size == "banner" or size == "quadrant" %}
    {% assign chart_height = "h--[59cqh]" %}
    {% if brief.mode == "bar" %}{% assign chart_points = brief.points | slice: 0, 5 %}{% endif %}
  {% endif %}
  <div class="flex flex--row flex--between flex--center-y gap--small w--full">
    <span class="title {{ title_size }} text--left grow" data-clamp="1">{{ brief.headline | escape }}</span>
    {% if brief.value != blank %}
      <span class="label label--base no-shrink">{{ brief.value | escape }}</span>
    {% endif %}
  </div>
  <div id="{{ chart_id }}" class="w--full {{ chart_height }}" data-chart-type="{{ brief.mode }}" data-points="{{ chart_points | json | escape }}">
    {% for point in chart_points limit: 3 %}
      <div class="label">{{ point.label | escape }} · {{ point.value }}</div>
    {% endfor %}
  </div>
  {% if chart_points.size < brief.points.size %}
    <span class="label label--small">First {{ chart_points.size }} of {{ brief.points.size }} categories</span>
  {% endif %}
  {% if brief.answer != blank and size == "full" %}
    <span class="label label--base" data-clamp="1">{{ brief.answer | escape }}</span>
  {% endif %}
  {% render "brief_source" with source: brief.source, source_size: source_size %}
  <script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
  {% if brief.mode == "area" %}
    <script src="https://trmnl.com/js/highcharts/12.3.0/pattern-fill.js"></script>
  {% endif %}
  <script>
    (() => {
      const node = document.getElementById("{{ chart_id }}");
      if (!node || !window.Highcharts) return;
      const type = node.dataset.chartType;
      const points = JSON.parse(node.dataset.points);
      const height = Math.floor(node.clientHeight) - 2;
      const compact = height < 165 || node.clientWidth < 375;
      const ink = getComputedStyle(node).color;
      const rule = Highcharts.color(ink).setOpacity(0.26).get();
      const scale = Math.max(1, Math.min(2, node.clientWidth / 760));
      const fontSize = Math.round((compact ? 12 : 16) * scale);
      const style = { color: ink, fontSize: fontSize + "px", fontWeight: "600", fontFamily: "Inter, sans-serif" };
      const chart = Highcharts.chart(node, {
        chart: {
          type, height, animation: false, backgroundColor: "transparent",
          spacing: [Math.ceil(fontSize * 0.75) + 2, 8, 4, Math.ceil(fontSize * 0.6)]
        },
        title: { text: null },
        credits: { enabled: false },
        legend: { enabled: false },
        tooltip: { enabled: false },
        xAxis: {
          categories: points.map(({ label }) => label),
          tickLength: 0, lineColor: rule,
          labels: { style, ...(compact && type !== "bar" && points.length > 5 ? { step: 2 } : {}) }
        },
        yAxis: {
          title: { text: null }, tickAmount: compact ? 3 : 5,
          gridLineColor: rule, gridLineDashStyle: "Dot",
          labels: { style },
          ...(type === "line" ? {} : { softMin: 0, softMax: 0 })
        },
        plotOptions: { series: { animation: false, enableMouseTracking: false } },
        series: [{
          data: points.map(({ value }) => value), color: ink, lineWidth: 2, borderWidth: 0,
          marker: { enabled: type !== "bar", radius: compact ? 2 : 3 },
          ...(type === "area" ? {
            fillColor: { pattern: { path: { d: "M 0 4 L 4 0", strokeWidth: 1 }, width: 5, height: 5, color: ink } }
          } : {})
        }]
      });
      chart.renderer.boxWrapper.css({ display: "block" });
    })();
  </script>
{% endtemplate %}

{% template brief_screen %}
  {% assign title_size = "title--large lg:title--xlarge" %}
  {% assign row_title_size = "title--small lg:title--base" %}
  {% assign detail_size = "description--medium lg:description--large" %}
  {% assign answer_size = "description--large lg:description--xlarge" %}
  {% assign source_size = "label--small lg:label--base" %}
  {% assign inset = "px--6" %}
  {% assign title_lines = 2 %}
  {% assign answer_lines = 5 %}
  {% assign item_limit = 3 %}
  {% assign metric_size = "value--xxlarge lg:value--xxxlarge" %}
  {% assign row_layout = "flex flex--col gap--small" %}
  {% if size == "banner" %}
    {% assign title_size = "title--base" %}
    {% assign row_title_size = "title--small" %}
    {% assign detail_size = "description--base" %}
    {% assign answer_size = "description--large" %}
    {% assign source_size = "label--small" %}
    {% assign inset = "" %}
    {% assign title_lines = 1 %}
    {% assign answer_lines = 2 %}
    {% assign item_limit = 2 %}
    {% assign metric_size = "value--large" %}
    {% assign row_layout = "grid grid--cols-2 gap--large" %}
  {% elsif size == "column" %}
    {% assign title_size = "title--medium" %}
    {% assign row_title_size = "title--base" %}
    {% assign detail_size = "description--base" %}
    {% assign answer_size = "description--large" %}
    {% assign source_size = "label--small" %}
    {% assign inset = "px--2" %}
    {% assign row_layout = "flex flex--col gap--medium" %}
  {% elsif size == "quadrant" %}
    {% assign title_size = "title--base" %}
    {% assign row_title_size = "title--base" %}
    {% assign detail_size = "description--medium" %}
    {% assign answer_size = "description--large" %}
    {% assign source_size = "label--small" %}
    {% assign inset = "" %}
    {% assign title_lines = 2 %}
    {% assign answer_lines = 3 %}
    {% assign item_limit = 1 %}
    {% assign metric_size = "value--large" %}
  {% endif %}

  {% if brief.mode == "compare" %}
    {% assign item_limit = 2 %}
    {% if size != "column" %}
      {% assign row_layout = "grid grid--cols-2 gap--medium" %}
    {% endif %}
    {% if size == "full" %}
      {% assign row_title_size = "title--medium lg:title--large" %}
    {% elsif size == "quadrant" %}
      {% assign row_title_size = "title--small" %}
    {% endif %}
  {% endif %}

  <div class="layout layout--col">
    <div class="flex flex--col flex--stretch-x gap--small w--full {{ inset }}">
      {% if brief.mode == "image" %}
        {% render "brief_image" with brief: brief, size: size, title_size: title_size, source_size: source_size %}
      {% elsif brief.points %}
        {% render "brief_chart" with brief: brief, size: size, title_size: title_size, source_size: source_size %}
      {% elsif brief.mode == "table" %}
        {% assign row_limit = 6 %}
        {% assign table_size = "table--base" %}
        {% if size == "banner" or size == "quadrant" %}
          {% assign row_limit = 3 %}
          {% assign table_size = "table--small" %}
        {% endif %}
        {% render "brief_heading" with headline: brief.headline, title_size: title_size, title_lines: 1 %}
        <table class="table {{ table_size }} w--full">
          <thead><tr>
            {% for column in brief.columns %}<th scope="col"><span class="title title--small" data-clamp="1">{{ column | escape }}</span></th>{% endfor %}
          </tr></thead>
          <tbody>
            {% for row in brief.rows limit: row_limit %}
              <tr>{% for cell in row %}<td><span class="label label--base" data-clamp="1">{{ cell | escape }}</span></td>{% endfor %}</tr>
            {% endfor %}
          </tbody>
        </table>
        <div class="flex flex--row flex--between flex--center-y">
          {% if brief.rows.size > row_limit %}<span class="label label--small">{{ row_limit }} of {{ brief.rows.size }} rows</span>{% endif %}
          {% render "brief_source" with source: brief.source, source_size: source_size %}
        </div>
      {% elsif brief.mode == "article" %}
        {% assign paragraph_limit = 3 %}
        {% assign paragraph_lines = 4 %}
        {% if size == "column" %}
          {% assign paragraph_limit = 2 %}
        {% elsif size == "banner" or size == "quadrant" %}
          {% assign paragraph_limit = 1 %}
          {% assign paragraph_lines = 3 %}
        {% endif %}
        {% render "brief_heading" with headline: brief.headline, title_size: title_size, title_lines: title_lines %}
        <article class="flex flex--col flex--stretch-x gap--medium">
          {% for paragraph in brief.paragraphs limit: paragraph_limit %}
            <p class="description {{ answer_size }}" data-clamp="{{ paragraph_lines }}">{{ paragraph | escape }}</p>
          {% endfor %}
        </article>
        {% render "brief_source" with source: brief.source, source_size: source_size %}
      {% elsif brief.mode == "bullets" or brief.mode == "timeline" %}
        {% assign point_limit = 5 %}
        {% if size == "banner" or size == "quadrant" %}
          {% assign point_limit = 3 %}
          {% if brief.mode == "timeline" or brief.items.first.source %}{% assign point_limit = 2 %}{% endif %}
        {% endif %}
        {% render "brief_heading" with headline: brief.headline, title_size: title_size, title_lines: 1 %}
        {% if brief.mode == "bullets" %}
          <ul class="flex flex--col flex--stretch-x gap--small w--full">
            {% for point in brief.items limit: point_limit %}
              <li class="flex flex--row flex--left flex--top gap--small w--full">
                <span class="label label--base" aria-hidden="true">•</span>
                <div class="flex flex--col flex--stretch-x gap--xsmall">
                  <span class="label label--base" data-clamp="2">{{ point.title | escape }}</span>
                  {% if point.detail != blank and size == "full" and point.source == blank %}
                    <span class="description" data-clamp="1">{{ point.detail | escape }}</span>
                  {% endif %}
                  {% render "brief_source" with source: point.source, source_size: source_size %}
                </div>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <ol class="flex flex--col flex--stretch-x gap--small w--full">
            {% for point in brief.items limit: point_limit %}
              <li class="grid gap--small w--full">
                <span class="label label--base col--span-3" data-clamp="1">{{ point.title | escape }}</span>
                <div class="flex flex--col flex--stretch-x gap--xsmall col--span-9">
                  <span class="label label--base" data-clamp="2">{{ point.detail | escape }}</span>
                  {% render "brief_source" with source: point.source, source_size: source_size %}
                </div>
              </li>
            {% endfor %}
          </ol>
        {% endif %}
      {% elsif brief.mode == "list" or brief.mode == "compare" %}
        {% if size != "quadrant" %}
          {% render "brief_heading" with headline: brief.headline, title_size: title_size, title_lines: title_lines %}
        {% endif %}
        <div class="{{ row_layout }} w--full">
          {% for pick in brief.items limit: item_limit %}
            {% if brief.mode == "compare" and size != "column" %}<div class="col col--start">{% endif %}
            <div class="item">
              {% if size != "quadrant" and brief.mode == "list" %}
                <div class="meta"><span class="index">{{ forloop.index }}</span></div>
              {% endif %}
              <div class="content">
                <span class="title {{ row_title_size }}" data-clamp="{% if size == 'full' %}1{% else %}2{% endif %}">{{ pick.title | escape }}</span>
                <span class="{% if brief.mode == 'compare' %}label label--base{% else %}description {{ detail_size }}{% endif %}" data-clamp="2">{{ pick.detail | escape }}</span>
                {% render "brief_source" with source: pick.source, source_size: source_size %}
              </div>
            </div>
            {% if brief.mode == "compare" and size != "column" %}</div>{% endif %}
          {% endfor %}
        </div>
      {% elsif brief.mode == "metric" %}
        <span class="label label--base" data-clamp="1">{{ brief.headline | escape }}</span>
        <span class="value {{ metric_size }}" data-fit-value="true">{{ brief.value | escape }}</span>
        <span class="label label--base" data-clamp="2">{{ brief.answer | escape }}</span>
        {% render "brief_source" with source: brief.source, source_size: source_size %}
      {% elsif brief.mode == "quote" %}
        <span class="title {{ title_size }} text--center" data-clamp="{{ answer_lines }}">“{{ brief.answer | escape }}”</span>
        <span class="label label--base self--center text--center" data-clamp="1">{{ brief.value | default: brief.headline | escape }}</span>
        {% render "brief_source" with source: brief.source, source_size: source_size, source_alignment: "self--center" %}
      {% elsif brief %}
        {% render "brief_heading" with headline: brief.headline, title_size: title_size, title_lines: title_lines %}
        <span class="description {{ answer_size }}" data-clamp="{{ answer_lines }}">{{ brief.answer | escape }}</span>
        {% render "brief_source" with source: brief.source, source_size: source_size %}
      {% else %}
        <span class="title {{ title_size }}">Prompt Frame</span>
        <span class="description" data-clamp="3">{{ notice | default: "Waiting for the first brief." | escape }}</span>
      {% endif %}
    </div>
  </div>

  <div class="title_bar">
    <span class="title">{{ trmnl.plugin_settings.instance_name | default: "Prompt Frame" | escape }}</span>
    {% if brief.generated_at %}
      {% assign generated_local = brief.generated_at | plus: trmnl.user.utc_offset %}
      <span class="instance">{% if stale %}Previous · {% endif %}{{ generated_local | date: "%b %-d · %H:%M" }}</span>
    {% endif %}
  </div>
{% endtemplate %}
